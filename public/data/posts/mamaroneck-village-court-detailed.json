info-box2705_467a53-db .kt-blocks-info-box-media-container{margin-top:0px;margin-right:15px;margin-bottom:10px;margin-left:15px;}.kt-info-box2705_467a53-db .kt-blocks-info-box-media .kadence-info-box-image-intrisic img{border-radius:200px;}.kt-info-box2705_467a53-db .kt-blocks-info-box-link-wrap:hover .kt-blocks-info-box-media{color:#444444;background:#eeeeee;}.kt-info-box2705_467a53-db .kt-infobox-textcontent h2.kt-blocks-info-box-title{font-size:26px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;margin-top:5px;margin-right:0px;margin-bottom:10px;margin-left:0px;}.kt-info-box2705_467a53-db .kt-infobox-textcontent .kt-blocks-info-box-text{color:#555555;}.kt-info-box2705_467a53-db .kt-blocks-info-box-learnmore{background:transparent;border-color:#555555;border-width:0px 0px 0px 0px;padding-top:4px;padding-right:8px;padding-bottom:4px;padding-left:8px;margin-top:10px;margin-right:0px;margin-bottom:10px;margin-left:0px;}.kt-info-box2705_467a53-db .kt-blocks-info-box-link-wrap:hover .kt-blocks-info-box-learnmore,.kt-info-box2705_467a53-db .kt-blocks-info-box-link-wrap .kt-blocks-info-box-learnmore:focus{color:#ffffff;background:#444444;border-color:#444444;}@media all and (max-width: 1024px){.kt-info-box2705_467a53-db .kt-blocks-info-box-link-wrap{border-top:5px solid #eeeeee;border-right:5px solid #eeeeee;border-bottom:5px solid #eeeeee;border-left:5px solid #eeeeee;}}@media all and (max-width: 767px){.kt-info-box2705_467a53-db .kt-blocks-info-box-link-wrap{border-top:5px solid #eeeeee;border-right:5px solid #eeeeee;border-bottom:5px solid #eeeeee;border-left:5px solid #eeeeee;}}</style>\n<div class=\"kt-info-box2705_467a53-db\"><div class=\"kt-blocks-info-box-media-container\"><div class=\"kt-blocks-info-box-media kt-info-media-animate-none\"><div class=\"kadence-info-box-icon-container kt-info-icon-animate-none\"><div class=\"kadence-info-box-icon-inner-container\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_chrome kt-info-svg-icon\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\"  aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><line x1=\"21.17\" y1=\"8\" x2=\"12\" y2=\"8\"/><line x1=\"3.95\" y1=\"6.06\" x2=\"8.54\" y2=\"14\"/><line x1=\"10.88\" y1=\"21.94\" x2=\"15.46\" y2=\"14\"/></svg></span></div></div></div></div><div class=\"kt-infobox-textcontent\"><h2 class=\"kt-blocks-info-box-title\">Website</h2><p class=\"kt-blocks-info-box-text\">https://www.village.mamaroneck.ny.us/justice-court</p></div></div>\n\n\n\n<div style=\"height:20px\" aria-hidden=\"true\"></div>\n\n\n<style>.wp-block-kadence-column.kb-section-dir-horizontal > .kt-inside-inner-col > .kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap{max-width:unset;}.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap{border-top:5px solid #eeeeee;border-right:5px solid #eeeeee;border-bottom:5px solid #eeeeee;border-left:5px solid #eeeeee;border-top-left-radius:30px;border-top-right-radius:30px;border-bottom-right-radius:30px;border-bottom-left-radius:30px;background:var(--global-palette9, #ffffff);padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap:hover{background:var(--global-palette8, #F7FAFC);}.kt-info-box2705_321317-96 .kadence-info-box-icon-container .kt-info-svg-icon, .kt-info-box2705_321317-96 .kt-info-svg-icon-flip, .kt-info-box2705_321317-96 .kt-blocks-info-box-number{font-size:50px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-media{color:#444444;background:#eeeeee;border-radius:200px;overflow:hidden;border-top-width:0px;border-right-width:0px;border-bottom-width:0px;border-left-width:0px;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-media-container{margin-top:0px;margin-right:15px;margin-bottom:10px;margin-left:15px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-media .kadence-info-box-image-intrisic img{border-radius:200px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap:hover .kt-blocks-info-box-media{color:#444444;background:#eeeeee;}.kt-info-box2705_321317-96 .kt-infobox-textcontent h2.kt-blocks-info-box-title{font-size:26px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;margin-top:5px;margin-right:0px;margin-bottom:10px;margin-left:0px;}.kt-info-box2705_321317-96 .kt-infobox-textcontent .kt-blocks-info-box-text{color:#555555;}.kt-info-box2705_321317-96 .kt-blocks-info-box-learnmore{background:transparent;border-color:#555555;border-width:0px 0px 0px 0px;padding-top:4px;padding-right:8px;padding-bottom:4px;padding-left:8px;margin-top:10px;margin-right:0px;margin-bottom:10px;margin-left:0px;}.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap:hover .kt-blocks-info-box-learnmore,.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap .kt-blocks-info-box-learnmore:focus{color:#ffffff;background:#444444;border-color:#444444;}@media all and (max-width: 1024px){.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap{border-top:5px solid #eeeeee;border-right:5px solid #eeeeee;border-bottom:5px solid #eeeeee;border-left:5px solid #eeeeee;}}@media all and (max-width: 767px){.kt-info-box2705_321317-96 .kt-blocks-info-box-link-wrap{border-top:5px solid #eeeeee;border-right:5px solid #eeeeee;border-bottom:5px solid #eeeeee;border-left:5px solid #eeeeee;}}</style>\n<div class=\"kt-info-box2705_321317-96\"><div class=\"kt-blocks-info-box-media-container\"><div class=\"kt-blocks-info-box-media kt-info-media-animate-none\"><div class=\"kadence-info-box-icon-container kt-info-icon-animate-none\"><div class=\"kadence-info-box-icon-inner-container\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_mail kt-info-svg-icon\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\"  aria-hidden=\"true\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/><polyline points=\"22,6 12,13 2,6\"/></svg></span></div></div></div></div><div class=\"kt-infobox-textcontent\"><h2 class=\"kt-blocks-info-box-title\">Email</h2><p class=\"kt-blocks-info-box-text\">vomcourt@vomny.org</p></div></div>\n</div>\n</div>\n\n\n\n<p>Mamaroneck Village Court is one of 37 villages and city courts in the County of Westchester, New York. It is located within the 2nd and 9th Judicial District Departments. It has jurisdiction over criminal, civil, small claims, landlord, village code violation and parking ticket matters. It also handles traffic, vehicle and speeding ticket cases. The court session will be held every Tuesday and Thursday at 9:30 am. The dress code should be followed during the case hearing.</p>\n\n\n\n<h2><strong><strong>Division:</strong></strong></h2>\n\n\n\n<p>Mamaroneck Village Court records information is available in the town clerk's and county clerk's offices and found online on different websites. All the case information and trails are recorded and maintained by the county and clerk's office. They can be searched online by using the following ways:</p>\n\n\n\n<ul>\n<li>Searching by case number</li>\n\n\n\n<li>Searching by name and city/state</li>\n\n\n\n<li>Searching by address</li>\n\n\n\n<li>Searching by phone</li>\n\n\n\n<li>Searching by email</li>\n</ul>\n\n\n\n<p>Sometimes, information about records is unavailable online because it is confidential according to the law. These types of information are only available at the county court or county clerk's office. They can be obtained by filing and sending a record request form. Fill in your name, phone number, email, address, city, state, zip code, and all other required information. Send the fees for the copies of the record. After receiving the form, the court will respond with whether to provide this information. For more information about the public records, call or mail the court.</p>\n\n\n\n<p>see also <strong>Cumberland County Courthouse</strong> </p>\n\n\n\n<h2><strong><strong><strong><strong><strong><strong>How to make payments?</strong></strong></strong></strong></strong></strong></h2>\n\n\n\n<p>Mamaroneck Village Court payment for tickets and fines can be made in the following ways:</p>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9, .wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9[data-kb-block=\"kb-adv-heading2705_6db87e-e9\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9 mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9[data-kb-block=\"kb-adv-heading2705_6db87e-e9\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9 img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading2705_6db87e-e9[data-kb-block=\"kb-adv-heading2705_6db87e-e9\"] img.kb-inline-image{width:150px;vertical-align:baseline;}</style>\n<h3 class=\"kt-adv-heading2705_6db87e-e9\" data-kb-block=\"kb-adv-heading2705_6db87e-e9\">In-Person</h3>\n\n\n\n<p>A person can pay for tickets and fines by visiting the court during regular court hours and paying in cash, checks, or with a card at the counter. 2.99% processing and other charges will be applied if you make payment with a credit card. </p>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f, .wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f[data-kb-block=\"kb-adv-heading2705_0ec92e-7f\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f[data-kb-block=\"kb-adv-heading2705_0ec92e-7f\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading2705_0ec92e-7f[data-kb-block=\"kb-adv-heading2705_0ec92e-7f\"] img.kb-inline-image{width:150px;vertical-align:baseline;}</style>\n<h3 class=\"kt-adv-heading2705_0ec92e-7f\" data-kb-block=\"kb-adv-heading2705_0ec92e-7f\">Online</h3>\n\n\n\n<p>A person can pay online for a parking ticket using the online payment portal https://mamaroneckny.rmcpay.com/. Enter the parking ticket number and use any online payment method. The traffic criminal and other ticket payments can be made using https://www.ncourt.com/x-press/x-onlinepayments.aspx?juris=07C0784E-EBFD-4613-9B28-DC3C9FE06D14. Enter the case or ticket number. The convenience fees will be applied in this case.</p>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79, .wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79[data-kb-block=\"kb-adv-heading2705_cbb5d5-79\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79 mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79[data-kb-block=\"kb-adv-heading2705_cbb5d5-79\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79 img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading2705_cbb5d5-79[data-kb-block=\"kb-adv-heading2705_cbb5d5-79\"] img.kb-inline-image{width:150px;vertical-align:baseline;}</style>\n<h3 class=\"kt-adv-heading2705_cbb5d5-79\" data-kb-block=\"kb-adv-heading2705_cbb5d5-79\">Mail</h3>\n\n\n\n<p>A Person can send a certified check or money order to the court's mailing address. The address is 169 Mt Pleasant Ave, Mamaroneck, NY 10543, United States. Cash or personal checks are not acceptable in the mail; only certified checks or money orders are accepted. Remember to write your citation when you send the payment, and mail the amount in a self-addressed, stamped envelope if you want a receipt.</p>\n\n\n\n<h2><strong><strong>The traffic court handles which types of cases?</strong></strong></h2>\n\n\n\n<p>Mamaroneck Village Traffic Court handles all the offense and violation cases related to speeding, traffic and vehicle matters. The violation and offense include:</p>\n\n\n\n<ul>\n<li>Driving with a suspended, expired or no license</li>\n\n\n\n<li>Drives recklessly or when taking drugs</li>\n\n\n\n<li>Drive with a high-speed limit that is not allowed</li>\n\n\n\n<li>Operate vehicles with improper tags or improper plates</li>\n\n\n\n<li>Fail to yield</li>\n\n\n\n<li>Do not stop at the red signal or stop sign</li>\n\n\n\n<li>Drive without a seat belt</li>\n\n\n\n<li>Using a mobile phone while driving</li>\n\n\n\n<li>Do not obey traffic control devices and rules</li>\n</ul>\n\n\n\n<p>If you receive a ticket, enter a plea and send it to the court before the citation date. Hire an attorney if you need help or guidance related to the ticket.</p>\n\n\n\n<h2><strong><strong>What is the procedure for filing a small claim case?</strong></strong></h2>\n\n\n\n<p>Village of Mamaroneck small claims court will handle all the claims matters having a limit of $3000.$10 is the filing fee for a claim less than $1000 and $15 for claims up to $ 3000. The small claim case is filled when you fill in all the information for the case form. Write your data and the person you are suing name, reason and amount you sue. The person you are claiming must be a resident of this town. You cannot file claims against a corporation, partnership and LLC in this court; only a case can be done against an individual or some person.</p>\n\n\n\n<p>see also <strong>Travis County District Clerk Office</strong></p>\n\n\n\n<h2><strong>How can I send a plea to the court?</strong></h2>\n\n\n\n<p>Mamaroneck Village Court plea can only be written if you received a traffic, vehicle or parking ticket. Write a plea and send it before the citation date noted on your ticket. Download the plea form, write the Ticket or Case Number, name, birth date and email address and then tick the plea you want. Two types of plea can be written and mailed to the court that are:</p>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db, .wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db[data-kb-block=\"kb-adv-heading2705_077795-db\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db[data-kb-block=\"kb-adv-heading2705_077795-db\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading2705_077795-db[data-kb-block=\"kb-adv-heading2705_077795-db\"] img.kb-inline-image{width:150px;vertical-align:baseline;}</style>\n<h3 class=\"kt-adv-heading2705_077795-db\" data-kb-block=\"kb-adv-heading2705_077795-db\">Plea of Guilty</h3>\n\n\n\n<p>Choose a guilty plea if you admit you violated the law or committed a crime. The court will review your application and respond with the fine amount. You do not have to appear in court; only pay the fine on time.</p>\n\n\n<style>.wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c, .wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c[data-kb-block=\"kb-adv-heading2705_1bf635-5c\"]{font-size:var(--global-kb-font-size-md, 1.25rem);font-style:normal;}.wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c mark.kt-highlight, .wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c[data-kb-block=\"kb-adv-heading2705_1bf635-5c\"] mark.kt-highlight{font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}.wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c img.kb-inline-image, .wp-block-kadence-advancedheading.kt-adv-heading2705_1bf635-5c[data-kb-block=\"kb-adv-heading2705_1bf635-5c\"] img.kb-inline-image{width:150px;vertical-align:baseline;}</style>\n<h3 class=\"kt-adv-heading2705_1bf635-5c\" data-kb-block=\"kb-adv-heading2705_1bf635-5c\">Plea of Not Guilty</h3>\n\n\n\n<p>If you do not accept your offense and deny all the violations against you, then choose the plea of not guilty. The court will review your application and send you a schedule for your court appearance, and you have to appear on time. You had to appear with all the proof in your defense. Hire an attorney in this case. In the end, write your signature and date and mail it to the court. You had to write each ticket plea if you received many tickets. Pay the fine or appear in court according to the schedule; otherwise, the additional fine will be added, your driver's license and insurance will expire, and sometimes a warrant against you will be issued.</p>\n\n\n\n<h2><strong>How much fines a person had to pay for traffic and vehicle violations?</strong></h2>\n\n\n\n<p>Mamaroneck Village Court's fine depends upon the type of violation a person has committed. $100- $300 for a traffic infraction violation, $225-$675 for not obeying a traffic signal,$25-$200 for driving an uninspected vehicle etc. Points are added for each violation, and if you continue the violation, then a point is reached where your driving license will be suspended.</p>\n\n\n\n<p>see also <strong>Birmingham Municipal Court</strong></p>\n\n\n\n<div style=\"height:30px\" aria-hidden=\"true\"></div>\n\n\n\n<h3><strong>FAQ:</strong></h3>\n\n\n\n<div style=\"height:20px\" aria-hidden=\"true\"></div>\n\n\n\n<div class=\"is-layout-flex\">\n<div class=\"is-layout-flow\" style=\"flex-basis:100%\">\n<h6 class=\"has-text-align-center\">What is the dress code in the court session?</h6>\n</div>\n</div>\n\n\n\n<div class=\"is-layout-flex\">\n<div class=\"is-layout-flow\" style=\"flex-basis:100%\">\n<p class=\"has-text-align-center\">Appropriate and proper dressing is required. Sleeveless, torn and tight clothes are not allowed during the session.</p>\n</div>\n</div>\n\n\n\n<div style=\"height:20px\" aria-hidden=\"true\"></div>\n\n\n\n<div style=\"height:40px\" aria-hidden=\"true\"></div>\n",
